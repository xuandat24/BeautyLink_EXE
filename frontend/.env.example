# Local development uses the Vite /api proxy, so this can remain empty.
# For Vercel, set this to the public Railway backend URL including /api.
# Example: https://beautylink-backend-production.up.railway.app/api
VITE_API_BASE_URL=

# Only enable this for an intentional offline UI demonstration. Keep it false
# when the frontend is connected to the Spring Boot backend.
VITE_ENABLE_DEMO_FALLBACK=false
