# Local development uses the Vite /api proxy, so this can remain empty.
# For Vercel, set this to the public Railway backend URL including /api.
# Example: https://beautylink-backend-production.up.railway.app/api
VITE_API_BASE_URL=

# Google Identity Services OAuth 2.0 Web client ID. Configure the same client ID
# in GOOGLE_CLIENT_IDS on the backend; this is public configuration, not a secret.
VITE_GOOGLE_CLIENT_ID=

# Only enable this for an intentional local offline UI demonstration. Production
# builds ignore this flag and always use the live API/database.
VITE_ENABLE_DEMO_FALLBACK=false

# Classroom presentation: 90 bookings, 78 customers, 59 completed, 1,906,000 VNĐ
# commission, sample ratings and seeded email aliases. Does not change the DB.
VITE_PRESENTATION_DATA=false
