# Local setup: use a complete JDBC URL. Railway can instead provide the
# MYSQLHOST, MYSQLPORT, MYSQLDATABASE, MYSQLUSER, and MYSQLPASSWORD variables.
MYSQL_JDBC_URL=jdbc:mysql://localhost:3306/beautylink?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Bangkok&characterEncoding=UTF-8
MYSQL_USERNAME=your_mysql_username
MYSQL_PASSWORD=your_mysql_password
JWT_SECRET=replace-with-at-least-32-random-characters
KYC_ENCRYPTION_KEY=replace-with-a-different-random-secret-of-at-least-32-characters
OTP_PEPPER=replace-with-a-third-random-secret-of-at-least-32-characters
JWT_EXPIRATION_MS=3600000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Comma-separated OAuth 2.0 Web client IDs accepted as Google ID-token audiences.
GOOGLE_CLIENT_IDS=
SUPPLIER_AUTO_VERIFY=true
DEMO_DATA_ENABLED=false
DEMO_ACCOUNT_PASSWORD=
LOGIN_MAX_PER_IDENTIFIER=8
LOGIN_MAX_PER_IP=20
LOGIN_RATE_WINDOW_SECONDS=900
REGISTRATION_MAX_PER_IP=5
REGISTRATION_RATE_WINDOW_SECONDS=3600
OTP_MAX_SENDS_PER_TARGET=5
OTP_SEND_WINDOW_SECONDS=3600
OTP_CODE_TTL_SECONDS=600
OTP_REGISTRATION_TOKEN_TTL_SECONDS=900
OTP_MAX_ATTEMPTS=5
# Use memory for one local instance. Production profile defaults to redis.
RATE_LIMIT_BACKEND=memory
REDIS_URL=redis://localhost:6379
REDIS_TIMEOUT=2s
# Production OTP delivery: Resend HTTPS API (port 443) is preferred.
RESEND_API_KEY=
OTP_MAIL_FROM=no-reply@beautylink.cloud
# Booking confirmation email stays disabled until the Resend sending domain,
# Railway variables, and outbox migration have been reviewed in production.
BOOKING_EMAIL_ENABLED=false
BOOKING_EMAIL_FROM=BeautyLink <no-reply@beautylink.cloud>
BOOKING_EMAIL_REPLY_TO=
FRONTEND_PUBLIC_URL=https://beautylink.cloud
BOOKING_EMAIL_MAX_ATTEMPTS=5
BOOKING_EMAIL_DISPATCH_BATCH_SIZE=20
BOOKING_EMAIL_DISPATCH_MS=15000
BOOKING_EMAIL_DISPATCH_INITIAL_DELAY_MS=30000
BOOKING_EMAIL_LEASE_SECONDS=120
# Optional local/test timeout overrides.
RESEND_CONNECT_TIMEOUT_MS=5000
RESEND_READ_TIMEOUT_MS=10000
# Optional local SMTP fallback when RESEND_API_KEY is empty.
SPRING_MAIL_HOST=smtp.example.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_REQUIRED=true
SPRING_MAIL_CONNECTION_TIMEOUT_MS=10000
SPRING_MAIL_TIMEOUT_MS=10000
SPRING_MAIL_WRITE_TIMEOUT_MS=10000
# payOS credentials are created in the payOS payment-channel dashboard.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=http://localhost:5173/?payment=success
PAYOS_CANCEL_URL=http://localhost:5173/?payment=cancelled
# Must be a public HTTPS endpoint reachable by PayOS in production.
PAYOS_WEBHOOK_URL=https://your-api.example.com/api/v1/payments/payos/webhook
# Optional polling controls used to reconcile pending transactions server-to-server.
PAYOS_RECONCILIATION_MS=60000
PAYOS_RECONCILIATION_INITIAL_DELAY_MS=60000
PAYOS_RECONCILIATION_MIN_AGE_SECONDS=60
PAYOS_RECONCILIATION_MIN_INTERVAL_SECONDS=120
# Public supplier/service/practitioner images (never KYC). Backend only, no VITE_ secrets.
CLOUDINARY_ENABLED=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_CONNECT_TIMEOUT_MS=3000
CLOUDINARY_READ_TIMEOUT_MS=6000
